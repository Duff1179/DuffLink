<?xml version="1.0" encoding="utf-8" ?>
<component name="StageDisplay" extends="Scene">
    <script type="text/brightscript" uri="pkg:/components/StageDisplay.brs" />
    
    <children>
        <Rectangle id="background" width="1920" height="1080" color="0x080A0CFF">
            <Label id="presName" text="WAITING..." color="0x4F8EF7FF" translation="[32, 20]" />
            <Label id="slideCounter" text="— / —" color="0x6B7280FF" translation="[1800, 20]" horizAlign="right" />
            <Rectangle id="liveDot" width="16" height="16" color="0x7F1D1DFF" translation="[1870, 30]" />
            
            <Rectangle width="1920" height="2" color="0x111518FF" translation="[0, 60]" />
            <Label text="ON SCREEN" color="0x374151FF" font="font:SmallSystemFont" translation="[32, 100]" />
            <Label id="currentText" text="Waiting for slides..." color="0x374151FF" font="font:LargeBoldSystemFont" wrap="true" width="1850" translation="[32, 140]" />
            
            <Rectangle width="1920" height="2" color="0x0C1014FF" translation="[0, 650]" />
            <Label text="UP NEXT" color="0x374151FF" font="font:SmallSystemFont" translation="[32, 680]" />
            <Label id="nextText" text="—" color="0x374151FF" font="font:LargeBoldSystemFont" wrap="true" width="1850" translation="[32, 720]" />
            
            <Rectangle width="1920" height="2" color="0x0C1014FF" translation="[0, 850]" />
            <Label text="SLIDES LEFT" color="0x4B5563FF" translation="[250, 880]" horizAlign="center" />
            <Label id="slidesLeftValue" text="—" color="0x4F8EF7FF" font="font:LargeBoldSystemFont" translation="[250, 920]" horizAlign="center" />
            
            <Rectangle width="2" height="200" color="0x0C1014FF" translation="[640, 850]" />
            <Label text="TIMER" color="0x4B5563FF" translation="[960, 880]" horizAlign="center" />
            <Label id="timerValue" text="—" color="0x34D399FF" font="font:LargeBoldSystemFont" translation="[960, 920]" horizAlign="center" />
            <Label id="timerName" color="0x6B7280FF" translation="[960, 1020]" horizAlign="center" font="font:SmallSystemFont" />
            
            <Rectangle width="2" height="200" color="0x0C1014FF" translation="[1280, 850]" />
            <Label text="SERVICE" color="0x4B5563FF" translation="[1600, 880]" horizAlign="center" />
            <Label id="serviceElapsedValue" text="—" color="0xC9D1DBFF" font="font:LargeBoldSystemFont" translation="[1600, 920]" horizAlign="center" />
            <Label text="elapsed" color="0x6B7280FF" translation="[1600, 1020]" horizAlign="center" font="font:SmallSystemFont" />
        </Rectangle>
        
        <Rectangle id="offlineOverlay" width="1920" height="1080" color="0x080A0CEE" visible="true">
            <Label text="Waiting for host..." color="0xC9D1DBFF" translation="[960, 500]" horizAlign="center" />
            <Label text="Make sure DuffLink is running on the host PC" color="0x6B7280FF" translation="[960, 550]" horizAlign="center" font="font:SmallSystemFont" />
        </Rectangle>
        
        <Timer id="serviceTimer" duration="1" repeat="true" />
        
        <!-- The RUN command has been safely moved to BrightScript -->
        <NetworkTask id="networkTask" />
    </children>
</component>