<?xml version="1.0" encoding="utf-8" ?>
<component name="StageDisplay" extends="Scene">
    <script type="text/brightscript" uri="pkg:/components/StageDisplay.brs" />
    
    <children>
        <Rectangle id="background" width="1920" height="1080" color="0x080A0CFF">
            
            <!-- TOP BAR -->
            <Label id="presName" text="WAITING..." color="0x4F8EF7FF" translation="[22, 11]" width="1400" wrap="false">
                <Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="22" />
            </Label>
            
            <Label id="slideCounter" text="— / —" color="0x374151FF" translation="[1550, 11]" width="350" horizAlign="right">
                <Font role="font" uri="pkg:/fonts/JetBrainsMono-SemiBold.ttf" size="22" />
            </Label>
            
            <Rectangle width="1920" height="2" color="0x111518FF" translation="[0, 50]" />
            
            <!-- CURRENT SLIDE -->
            <Label text="ON SCREEN" color="0x1F2937FF" translation="[22, 70]">
                <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="17" />
            </Label>
            <Label id="currentText" text="" color="0x1F2937FF" wrap="true" width="1850" numLines="3" translation="[22, 110]">
                <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="120" />
            </Label>
            
            <!-- NEXT SLIDE -->
            <Rectangle width="1920" height="2" color="0x0C1014FF" translation="[0, 650]" />
            <Label text="UP NEXT" color="0x1F2937FF" translation="[22, 670]">
                <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="17" />
            </Label>
            <Label id="nextText" text="" color="0x374151FF" wrap="true" width="1850" numLines="2" translation="[22, 710]">
                <Font role="font" uri="pkg:/fonts/Inter-Light.ttf" size="48" />
            </Label>
            
            <!-- METRICS ROW -->
            <Rectangle width="1920" height="2" color="0x0C1014FF" translation="[0, 850]" />
            
            <!-- Slides Left -->
            <Label text="SLIDES LEFT" color="0x4B5563FF" translation="[0, 860]" width="640" horizAlign="center">
                <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="28" />
            </Label>
            <Label id="slidesLeftValue" text="—" color="0x4F8EF7FF" translation="[0, 890]" width="640" horizAlign="center">
                <Font role="font" uri="pkg:/fonts/JetBrainsMono-SemiBold.ttf" size="80" />
            </Label>
            
            <Rectangle width="2" height="230" color="0x0C1014FF" translation="[640, 850]" />
            
            <!-- Timer (Aligned with Service) -->
            <Label text="TIMER" color="0x4B5563FF" translation="[640, 860]" width="640" horizAlign="center">
                <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="28" />
            </Label>
            <Label id="timerValue" text="—" color="0x34D399FF" translation="[640, 890]" width="640" horizAlign="center">
                <Font role="font" uri="pkg:/fonts/JetBrainsMono-SemiBold.ttf" size="80" />
            </Label>
            <Label id="timerName" color="0x6B7280FF" translation="[640, 990]" width="640" horizAlign="center">
                <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="26" />
            </Label>
            
            <Rectangle width="2" height="230" color="0x0C1014FF" translation="[1280, 850]" />
            
            <!-- Service -->
            <Label text="SERVICE" color="0x4B5563FF" translation="[1280, 860]" width="640" horizAlign="center">
                <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="28" />
            </Label>
            <Label id="serviceElapsedValue" text="—" color="0xE2E5E9FF" translation="[1280, 890]" width="640" horizAlign="center">
                <Font role="font" uri="pkg:/fonts/JetBrainsMono-SemiBold.ttf" size="80" />
            </Label>
            <Label text="elapsed" color="0x6B7280FF" translation="[1280, 990]" width="640" horizAlign="center">
                <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="26" />
            </Label>
        </Rectangle>
        
        <!-- OFFLINE OVERLAY -->
        <Rectangle id="offlineOverlay" width="1920" height="1080" color="0x080A0CEE" visible="true">
            <Label text="Waiting for host..." color="0x374151FF" translation="[0, 500]" width="1920" horizAlign="center">
                <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="30" />
            </Label>
            <Label text="Make sure DuffLink is running on the host PC" color="0x1F2937FF" translation="[0, 550]" width="1920" horizAlign="center">
                <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="22" />
            </Label>
            
            <!-- Manual Override Instruction -->
            <Label text="Press OK on your remote to enter IP manually" color="0x374151FF" translation="[0, 620]" width="1920" horizAlign="center">
                <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="18" />
            </Label>
        </Rectangle>
        
        <Timer id="serviceTimer" duration="1" repeat="true" />
        <NetworkTask id="networkTask" />
    </children>
</component>